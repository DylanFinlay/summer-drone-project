# Safe installed defaults. systemd installation does not enable the service.
# Change values only after completing the deployment and props-off checklist.

DRONE_CONFIGURATION_PROFILE=bench
DRONE_AUTONOMY_MODE=hover
DRONE_ENABLE_VISION=false
DRONE_ENABLE_OBJECT_DETECTION=true
DRONE_ENABLE_GESTURE_CONTROL=false
DRONE_ENABLE_GESTURE_RECOGNITION=false
DRONE_ENABLE_TRACKING=true
DRONE_ENABLE_RC_AUX_MODE_SELECTION=false
DRONE_RC_AUX_CHANNEL=0
DRONE_ENABLE_FC_INTERFACE=false
DRONE_ENABLE_FLIGHT_LOGGING=false
DRONE_FCU_URL=serial:///dev/ttyAMA0:57600
DRONE_GCS_URL=
DRONE_ROS_DOMAIN_ID=0
